package com.squid_configurator.squidconfig.services;

import static org.junit.jupiter.api.Assertions.assertEquals;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;

import com.squid_configurator.squidconfig.model.BandWidthRule;
import com.squid_configurator.squidconfig.model.enums.BandWidthType;

public class CacheServiceTest {
	private BandWidthService bandWidthService;
	
	@BeforeEach
	void setUp() {
		bandWidthService = new BandWidthService();
	}
	
	@Test
	void buildBandWidthLineTest() {
		BandWidthRule rule = new BandWidthRule(BandWidthType.DELAY_POOLS, "3");
		String result = bandWidthService.buildBandWidthLine(rule);
		assertEquals("delay_pools 3", result);
	}

}

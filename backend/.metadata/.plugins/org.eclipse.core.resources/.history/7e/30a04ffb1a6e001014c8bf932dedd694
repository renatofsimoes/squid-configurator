package com.squid_configurator.squidconfig.utils;

import java.io.IOException;
import java.nio.file.Path;
import java.util.List;

import com.squid_configurator.squidconfig.model.CacheRule;
import com.squid_configurator.squidconfig.model.enums.CacheType;
import com.squid_configurator.squidconfig.services.CacheService;

public class CacheFileEditor extends SquidConfFileEditor {

    private final CacheService cacheService = new CacheService();

    public CacheFileEditor(Path configFilePath) {
        super(configFilePath);
    }

    public void addCacheRule(CacheRule rule) throws IOException {
        String newLine = cacheService.buildCacheLine(rule);
        List<String> lines = readFile();
        validateLineNotExists(lines, newLine);
        switch (rule.getType()) {
            case CACHE_MEM:
            case MAXIMUM_OBJECT_SIZE:
            case MINIMUM_OBJECT_SIZE:
            case CACHE_SWAP_LOW:
            case CACHE_SWAP_HIGH:
                validateSingleInstanceDirective(lines, rule.getType());
                break;
            case CACHE_DIR:
            case REFRESH_PATTERN:
                break;
            default:
                throw new IllegalStateException("Tipo de cache não suportado: " + rule.getType());
        }
        int insertIndex = findInsertionIndex(lines);
        lines.add(insertIndex, newLine);
        writeConfigLines(lines);
    }

    public void removeCacheRule(CacheRule rule) throws IOException {
        String lineToRemove = cacheService.buildCacheLine(rule);
        List<String> lines = readFile();
        boolean removed = lines.removeIf(line -> line.trim().equals(lineToRemove.trim()));
        if (!removed) {
            throw new IllegalArgumentException("Regra de cache não encontrada no arquivo.");
        }
        writeConfigLines(lines);
    }

    private void validateSingleInstanceDirective(List<String> lines, CacheType type) {
        String prefix = getDirectivePrefix(type);
        boolean exists = lines.stream()
                .map(String::trim)
                .anyMatch(line -> line.startsWith(prefix + " "));
        if (exists) {
            throw new IllegalArgumentException("Já existe uma diretiva '" + prefix + "' no arquivo.");
        }
    }

    private String getDirectivePrefix(CacheType type) {
        // Define o nome real das diretivas conforme são escritas no squid.conf
        return switch (type) {
            case CACHE_MEM -> "cache_mem";
            case CACHE_DIR -> "cache_dir";
            case MAXIMUM_OBJECT_SIZE -> "maximum_object_size";
            case MINIMUM_OBJECT_SIZE -> "minimum_object_size";
            case REFRESH_PATTERN -> "refresh_pattern";
            case CACHE_SWAP_LOW -> "cache_swap_low";
            case CACHE_SWAP_HIGH -> "cache_swap_high";
        };
    }

    private int findInsertionIndex(List<String> lines) {
        // Insere após as ACLs, diretivas e regras de largura de banda
        int index = 0;
        for (int i = 0; i < lines.size(); i++) {
            String line = lines.get(i).trim();
            if (line.startsWith("acl ") ||
                line.startsWith("http_access ") ||
                line.startsWith("http_reply_access ") ||
                line.startsWith("url_rewrite_access ") ||
                line.startsWith("delay_pools ") ||
                line.startsWith("delay_class ") ||
                line.startsWith("delay_parameters ") ||
                line.startsWith("delay_access ")) {
                index = i + 1;
            }
        }
        return index;
    }
}


